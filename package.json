{
  "name": "gtexp",
  "version": "2026.1007.1",
  "private": true,
  "description": "Google タイムラインのエクスポートを蓄積して、いつどこに行ったかを調べる Web アプリ",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/gorry/gtexp.git"
  },
  "type": "module",
  "scripts": {
    "predev:server": "node tools/profile.mjs && node tools/buildinfo.mjs --if-missing",
    "dev:server": "tsx watch src/server/main.ts serve",
    "predev:client": "node tools/profile.mjs && node tools/buildinfo.mjs --if-missing",
    "dev:client": "vite",
    "build": "npm run build:client && npm run build:server",
    "prebuild:client": "node tools/profile.mjs && node tools/buildinfo.mjs",
    "build:client": "vite build",
    "prebuild:server": "node tools/profile.mjs && node tools/buildinfo.mjs",
    "build:server": "esbuild src/server/main.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/server.mjs",
    "pretypecheck": "node tools/profile.mjs && node tools/buildinfo.mjs --if-missing",
    "typecheck": "tsc --noEmit",
    "precli": "node tools/profile.mjs && node tools/buildinfo.mjs --if-missing",
    "cli": "tsx src/server/main.ts"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@preact/preset-vite": "^2.10.6",
    "@types/google.maps": "^3.66.5",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "preact": "^10.29.8",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.3"
  }
}
